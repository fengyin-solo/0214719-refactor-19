# 开发环境配置
VITE_APP_TITLE=台球俱乐部 - 开发环境
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
VITE_LOG_LEVEL=debug
# 请求超时时间（毫秒）
VITE_HTTP_TIMEOUT=10000
# 模拟场景：success(成功) / empty(空数据) / timeout(超时) / error(异常) / random(随机)
# 也可在浏览器控制台通过 __setMockScenario('timeout') 动态切换，__resetMockScenario() 恢复
VITE_MOCK_SCENARIO=success
