# 环境变量配置示例
# 复制此文件为 .env.local 进行本地配置

# 应用标题
VITE_APP_TITLE=台球俱乐部

# 是否使用模拟数据 (true/false)
# true: 使用前端模拟数据，无需后端服务
# false: 调用真实后端API
VITE_USE_MOCK=true

# API基础地址
# 模拟模式下此配置无效
# 真实模式下配置后端服务地址，如: https://api.example.com
VITE_API_BASE_URL=/api

# 日志级别 (debug/info/warn/error)
VITE_LOG_LEVEL=info

# 单次请求超时时间（毫秒，默认 10000）
VITE_HTTP_TIMEOUT=10000

# 模拟场景（仅 VITE_USE_MOCK=true 时生效）
# success: 正常返回
# empty:   集合接口返回空数据（球桌/课程/赛事/商品/预约/任务）
# timeout: 请求超时（触发 GET 自动重试）
# error:   服务异常（HTTP 500，触发 GET 自动重试）
# random:  每次请求随机命中以上场景
VITE_MOCK_SCENARIO=success
