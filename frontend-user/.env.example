# 环境变量配置示例
# 复制此文件为 .env.local 进行本地配置

# 应用标题
VITE_APP_TITLE=台球俱乐部

# 是否使用模拟数据 (true/false)
# true: 使用前端统一模拟层（src/mock），无需后端服务
# false: 调用真实后端API（响应契约见 README「真实接口对接」）
VITE_USE_MOCK=true

# API基础地址
# 模拟模式下此配置无效
# 真实模式下配置后端服务地址，如: https://api.example.com
VITE_API_BASE_URL=/api

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=8000

# GET 请求自动重试次数（超时/网络异常/5xx 时生效；POST 等写操作不自动重试）
VITE_REQUEST_RETRY=1

# 模拟延迟（毫秒），不配置则为 500-1000ms 随机延迟；测试环境自动设为 0
VITE_MOCK_DELAY=

# 日志级别 (debug/info/warn/error)
VITE_LOG_LEVEL=info
